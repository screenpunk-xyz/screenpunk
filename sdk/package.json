{
  "name": "@screenpunk/sdk",
  "version": "0.0.1",
  "private": true,
  "description": "Small TypeScript dashboard SDK. Bundled locally; no Node on devices.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "bundle": "node scripts/bundle-browser.mjs",
    "sync-examples": "node scripts/bundle-browser.mjs && node --import tsx scripts/sync-example-packages.ts",
    "build": "tsc -p tsconfig.json && node scripts/bundle-browser.mjs",
    "test": "tsc -p tsconfig.json --noEmit && node scripts/bundle-browser.mjs && node --test --import tsx test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "tsx": "4.19.3",
    "typescript": "5.8.2"
  }
}
