{
  "name": "@screenpunk/sdk",
  "version": "0.0.1",
  "private": true,
  "description": "Small TypeScript dashboard SDK. Bundled locally; no Node on devices.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json --noEmit && node --test --import tsx test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "tsx": "4.19.3",
    "typescript": "5.8.2"
  }
}
