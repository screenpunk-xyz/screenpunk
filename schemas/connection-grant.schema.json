{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://screenpunk.xyz/schemas/connection-grant/v1.json",
  "title": "Screenpunk connection grant",
  "description": "Trusted Mac-side grant. Packages only name aliases. Secrets stay in Keychain, never in this document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "alias",
    "origin",
    "transport",
    "authRef",
    "lan",
    "allowInsecureHTTP",
    "operations"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "alias": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "origin": {
      "type": "string",
      "pattern": "^https?://[A-Za-z0-9._:-]+$"
    },
    "transport": { "enum": ["http", "ws"] },
    "authRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Keychain reference name, not a secret value."
    },
    "lan": { "type": "boolean" },
    "allowInsecureHTTP": { "type": "boolean" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "method", "path", "idempotent", "write"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "kind": { "enum": ["http", "ws"] },
          "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
          "path": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9._~:/?#[\\]@!$&'()*+,;=%-]*$"
          },
          "idempotent": { "type": "boolean" },
          "write": { "type": "boolean" },
          "maxAgeSeconds": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
